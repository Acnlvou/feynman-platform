# ===== 费曼学习平台 · 后端环境变量示例 =====
# 使用方法：把本文件复制一份改名为 .env，然后填入自己的真实值。
# .env 已被 .gitignore 忽略，不会进入版本库，也不会被打进分发压缩包。

# 服务端口
PORT=3000

# MongoDB Atlas 连接串
# 获取方式：Atlas → Cluster → Connect → Drivers → Node.js
# 需要改动 3 处：<db_password> 换成真实密码、用户名换成自己的数据库用户、.net/ 后补上数据库名
MONGO_URI=mongodb+srv://<用户名>:<密码>@cluster0.xxxxx.mongodb.net/feynman-db?retryWrites=true&w=majority&appName=Cluster0

# JWT 签名密钥：请替换为一串足够长的随机字符串，绝对不要外泄
JWT_SECRET=replace_with_a_long_random_string

# JWT 有效期（对应讲义约定：5 小时）
JWT_EXPIRE=5h
