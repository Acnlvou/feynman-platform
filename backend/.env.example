# ===== 费曼学习平台 · 后端环境变量示例 =====
# 使用方法：复制为 .env 并填入本机配置；真实 .env 已被 .gitignore 忽略。

PORT=3000

# 腾讯云 CloudBase 环境配置（服务端 API Key 仅能放在后端，不能放进前端）
CLOUDBASE_ENV_ID=feynman-dev-d9gql03np7c2db9c2
CLOUDBASE_REGION=ap-shanghai
CLOUDBASE_APIKEY=replace_with_server_api_key

# JWT 签名密钥：请使用足够长的随机字符串，不要外泄
JWT_SECRET=replace_with_a_long_random_string

# JWT 有效期（对应讲义约定：5 小时）
JWT_EXPIRE=5h

# 第7课：百度短语音识别标准版（独立开通，非CloudBase Key）
# 仅后端读取；不配置时录音回放可用，转录接口返回503
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 第8/9课生成模型当前只启用 DeepSeek；其他模型变量保留作配置备份。
# SiliconFlow API Key 还用于第10课 Embedding；所有密钥仅后端读取，不要使用 VITE_*。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# 第10课：硅基流动 Embedding，复用上面的 SiliconFlow API Key，模型单独配置。
# 不配置时笔记仍保存，索引标记失败；每块按讲义 500 字、重叠 50 字。
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# 保留的其他千帆生成模型配置；当前代码未调用。
QIANFAN_MODEL=
