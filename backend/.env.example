# ===== 费曼学习平台 · 后端环境变量示例 =====
# 使用方法：复制为 .env 并填入本机配置；真实 .env 已被 .gitignore 忽略。

PORT=3000

# 腾讯云 CloudBase 环境配置（服务端 API Key 仅能放在后端，不能放进前端）
CLOUDBASE_ENV_ID=feynman-dev-d9gql03np7c2db9c2
CLOUDBASE_REGION=ap-shanghai
CLOUDBASE_APIKEY=replace_with_server_api_key

# JWT 签名密钥：请使用足够长的随机字符串，不要外泄
JWT_SECRET=replace_with_a_long_random_string

# JWT 有效期（对应讲义约定：5 小时）
JWT_EXPIRE=5h

# 第7课：百度短语音识别标准版（独立开通，非CloudBase Key）
# 仅后端读取；不配置时录音回放可用，转录接口返回503
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 第8课：当前只启用 DeepSeek；需同时填写 API Key 和模型ID，不保证免费。
# 其他供应商变量先保留作配置备份，当前运行代码不会读取或调用它们。
# 仅服务端读取，不要使用 VITE_*，不要复用百度语音凭据。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# 千帆V2 Bearer API Key（不是语音Key，也不是旧版API Key/Secret Key组合）
QIANFAN_API_KEY=
QIANFAN_MODEL=
